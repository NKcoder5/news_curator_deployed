# Values for docker-compose.yml only. Copy to `.env` in the repository root.
# The API's own settings live in backend/.env (see backend/.env.example).
# Every line is optional; the defaults shown are used when it is commented out.

# Host ports the stack is published on.
# FRONTEND_PORT=8080
# BACKEND_PORT=5000

# Browser origins the API will accept. Set this to the web app's address when you
# change FRONTEND_PORT, e.g. http://localhost:9090.
# CORS_ORIGINS=http://localhost:8080

# API address baked into the web app at build time. Leave unset: on localhost the
# app finds http://localhost:5000 by itself. See frontend/.env.example.
# REACT_APP_API_URL=
