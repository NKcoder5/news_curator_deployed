# === Node modules ===
node_modules/
**/node_modules/


# === Build Artifacts ===
dist/
build/
**/dist/
**/build/

# === Logs ===
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# === OS Generated Files ===
.DS_Store
Thumbs.db

# === IDE and Editor Files ===
.vscode/
.idea/

# === Misc ===
*.local
*.log
*.cache
.env
**/.env

# === Evaluation datasets and results (large / regenerable) ===
backend/eval/data/
!backend/eval/data/smoke.csv
backend/eval/results/
# === Office lock files ===
# Word writes ~$name.docx beside an open document and deletes it on close.
~$*

# === OCR language packs ===
# tesseract.js downloads these on first use (a few MB each) and caches them
# beside the process. Regenerable, so not tracked.
*.traineddata

# === Local Claude Code state (worktrees, machine settings) ===
.claude/worktrees/
.claude/settings.local.json
