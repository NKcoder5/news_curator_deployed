# Pure Press backend configuration.
#
# Copy this file to `.env` in the same folder and fill it in. `.env` is ignored
# by git; never commit real values. Every variable is explained in
# docs/engineering/configuration.md, including what stops working without it.
#
# Optional settings are commented out on purpose. A blank value is not the same
# as an unset one: `RECHECK_DAILY_CAP=` reads as 0 (no re-checks at all) and
# `NEWS_INDEX_LAG_HOURS=` reads as 0 (the news index is assumed to be live).
# Leave a line commented out unless you mean to set it.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Port the API listens on. Render supplies its own and overrides this.
PORT=5000

# Extra browser origins allowed to call the API, comma separated. The built-in
# list already allows http://localhost:3000 and the Render URL. A frontend served
# from any other address (another port, a custom domain) must be listed here or
# the browser refuses every call.
# CORS_ORIGINS=https://your-frontend.example.com

# ---------------------------------------------------------------------------
# Database and accounts (required)
# ---------------------------------------------------------------------------
# MongoDB connection string. Without a reachable database the server exits at
# start-up. Atlas looks like:
#   mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/news_curator?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/news_curator

# Secret that signs sign-in tokens. Use a long random value and keep it stable:
# changing it signs every reader out. Generate one with
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# Language models (at least one of the three is needed for a full check)
# ---------------------------------------------------------------------------
# Keys are commented out because a placeholder counts as a configured key: the
# gateway would try it, fail, and only then move to the next provider.
#
# Google Gemini. Free keys are available from Google AI Studio. The gateway
# rotates across six Gemini models, each with its own daily quota.
# GEMINI_API_KEY=your-gemini-api-key
# Further Gemini keys from other Google Cloud projects, comma separated. Each one
# adds a full day of quota per model.
# GEMINI_EXTRA_KEYS=second-key,third-key
# Replaces the first model in the Gemini rotation.
# GEMINI_MODEL_NAME=gemini-3.1-flash-lite

# NVIDIA NIM (hosted).
# NIM_API_KEY=your-nvidia-nim-api-key
# Replaces the first model in the NIM rotation.
# NIM_MODEL_NAME=nvidia/nemotron-3-ultra-550b-a55b

# "off" leaves Gemini and NIM out even with their keys set: no outside AI at all.
# HOSTED_AI=off

# Ollama running on the same machine or network. Setting the host switches it on.
# The writing checks are routed to it first (data/taskRouting.json).
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_MAX_CONCURRENT=2

# The laptop as the deployed server's model host (npm run own-model-server, on the laptop):
# the deployed server's INTERNAL_API_KEY, so the laptop may check in, and the model it serves.
# OWN_MODEL_API_URL=https://news-curator-deployed.onrender.com
# OWN_MODEL_API_KEY=the-deployed-internal-api-key
# OWN_MODEL=qwen3.5:9b

# Force the order providers are tried in, e.g. "gemini,nim,ollama". When set it
# overrides data/taskRouting.json. Leave unset to use the measured routing.
# LLM_PROVIDER=gemini,nim,ollama
# Calls allowed in flight per provider. The default suits each provider
# (Gemini 6, NIM 2, Ollama 2).
# LLM_MAX_CONCURRENT=4

# ---------------------------------------------------------------------------
# News and evidence
# ---------------------------------------------------------------------------
# NewsAPI key (https://newsapi.org). Powers the home feed and is the second place
# coverage is searched after Google News. The free plan allows 100 requests a
# day for the whole application.
# NEWS_API_KEY=your-newsapi-key

# Hours the news index is assumed to lag behind real time. A story newer than
# this is "too recent to corroborate" rather than "nobody reports it". Set 0 only
# on a plan that serves live articles.
# NEWS_INDEX_LAG_HOURS=3

# Google Fact Check Tools API key, only if you have one with billing enabled.
# Without it the same index is read through its public endpoint, which needs no
# key. A Gemini key does not work here.
# FACT_CHECK_API_KEY=your-fact-check-tools-key

# ---------------------------------------------------------------------------
# Claim memory
# ---------------------------------------------------------------------------
# Claims that could not be verified are looked at again after 6, 24 and 72
# hours. Set to false to switch the scheduler off.
# RECHECK_ENABLED=true
# Most re-checks started in any 24 hours; each one spends model calls.
# RECHECK_DAILY_CAP=40

# ---------------------------------------------------------------------------
# Abuse protection (backend/middleware/rateLimits.js)
# ---------------------------------------------------------------------------
# Per-reader and per-address allowances on checks, sign-in, signup and the
# public registry. Set to false only for local load tests.
# RATE_LIMIT_ENABLED=true
# Proxy hops to believe about the caller's address (X-Forwarded-For). Defaults
# to 1 on Render (RENDER is set there) and to loopback-only elsewhere. Too few
# and every reader shares the proxy's address; too many and a caller can
# claim any address.
# TRUST_PROXY=1

# ---------------------------------------------------------------------------
# Evaluation scripts only (backend/eval, not used by the running server)
# ---------------------------------------------------------------------------
# Key the evaluation scripts present in the x-internal-key header instead of
# signing in. When unset, that route into /api/ai is closed. Use a long random
# value, and never set it on a deployment you do not run evaluations against.
# INTERNAL_API_KEY=your-long-random-key
# Requests per minute the evaluation runner makes.
# EVAL_RPM=30
# Backend the matrix check calls.
# MATRIX_BASE=http://localhost:5000
