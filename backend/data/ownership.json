  "wireCreditNote": "Two kinds of signal, both meaning the facts came from the agency rather than from the printing outlet's own reporting: a dateline credit ('NEW DELHI (Reuters) -') and an explicit attribution ('according to Reuters', 'Reuters reported'). Bare mentions of an agency's name are deliberately NOT matched, so an article about Reuters the company is not mistaken for a Reuters story.",
  "wireCredits": [
    { "agency": "Reuters", "groupId": "reuters-group", "patterns": ["(reuters)", "reuters -", "— reuters", "via reuters", "thomson reuters", "according to reuters", "reuters report", "reuters said"] },
    { "agency": "Associated Press", "groupId": "ap-group", "patterns": ["(ap)", "(the associated press)", "associated press", "ap —", "via ap", "according to ap"] },
    { "agency": "AFP", "groupId": "afp-group", "patterns": ["(afp)", "agence france-presse", "via afp", "according to afp", "afp report"] },
    { "agency": "PTI", "groupId": "pti-group", "patterns": ["(pti)", "press trust of india", "-pti", "via pti", "according to pti", "pti report"] },
    { "agency": "ANI", "groupId": "ani-group", "patterns": ["(ani)", "asian news international", "via ani", "according to ani", "ani report"] },
    { "agency": "IANS", "groupId": "ians-group", "patterns": ["(ians)", "indo-asian news service", "according to ians"] }
